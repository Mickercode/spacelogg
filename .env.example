# ── SERVER ──
PORT=3000
NODE_ENV=production

# ── SECURITY ──
JWT_SECRET=your_random_secret_here

# ── DATABASE ──
DB_PATH=./db/spacelogg.db

# ── APP URL ──
APP_URL=https://www.spacelogg.com

# ── CLOUDINARY (image uploads) ──
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ── RESEND (email) ──
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=SpaceLogg <noreply@spacelogg.com>

# ── AUTO-CREATE ADMIN ON FIRST RUN ──
ADMIN_EMAIL=your_admin_email@example.com
ADMIN_PASSWORD=your_secure_password
ADMIN_NAME=Admin

# ── PAYSTACK (payments) ──
PAYSTACK_SECRET_KEY=sk_test_xxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxx

# ── COMMISSION (percentage SpaceLogg keeps from each booking) ──
COMMISSION_PERCENT=10

# ── INTEGRATION ENCRYPTION (64-char hex string) ──
INTEGRATION_SECRET=your_64_char_hex_key_here
